# Copy to .env.cloud-test (git-ignored) and fill in. Use a DEVELOPMENT Supabase project and throwaway test users.
# Create the users in the dashboard: Authentication > Users > Add user (tick "Auto Confirm User").
ORBIT_CLOUD_EMAIL=orbit-test-1@example.com
ORBIT_CLOUD_PASSWORD=
# Optional second user, enables the cross-student isolation test:
ORBIT_CLOUD_EMAIL2=
ORBIT_CLOUD_PASSWORD2=
# URL and key default to EXPO_PUBLIC_SUPABASE_URL / EXPO_PUBLIC_SUPABASE_ANON_KEY from .env
